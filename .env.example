# ==============================================================================
# DocCheck - Environment Configuration Example
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Get a free Gemini API key from Google AI Studio: https://aistudio.google.com/
# 3. Paste your API key below.
# ==============================================================================

# Google Gemini API Key (Required for AI analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-3.8-flash)
# Supported models: gemini-3.8-flash, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-3.8-flash

